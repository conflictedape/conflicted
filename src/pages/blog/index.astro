---
import { format } from 'date-fns';
import { getCollection, render, type CollectionEntry } from 'astro:content';

import Layout from '@/layouts/Layout.astro';
import { IS_DEV, withBase } from '@/lib/constants';

const getPostSlug = (post: CollectionEntry<'blog'>) => post.id.replace(/\/index$/, '');

const rawPosts = (await getCollection('blog', ({ data }) => IS_DEV || !data.draft)).sort(
	(a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const posts = await Promise.all(
	rawPosts.map(async (post) => {
		const { remarkPluginFrontmatter } = await render(post);
		return { post, readingTime: remarkPluginFrontmatter.readingTime as string | undefined };
	})
);
---

<Layout title="Blog" description="Writing about Astro, MDX, TypeScript, and building on the web.">
	<main class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="mb-10 space-y-4">
			<p class="text-primary text-sm font-semibold tracking-[0.2em] uppercase">Journal</p>
			<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Blog</h1>
			<p class="text-muted-foreground max-w-2xl text-base leading-7 sm:text-lg">
				Thoughts on software engineering, web development, and building things that feel fast,
				useful, and personal.
			</p>
		</div>

		<div class="space-y-6">
			{
				posts.map(({ post, readingTime }) => {
					const postSlug = getPostSlug(post);

					return (
						<article class="border-border bg-card/60 rounded-2xl border p-6 shadow-sm backdrop-blur">
							<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
								<div class="space-y-3">
									<div class="flex flex-wrap items-center gap-2">
										<p class="text-muted-foreground text-sm">
											{format(post.data.publishDate, 'MMMM d, yyyy')} · {readingTime}
										</p>
										{post.data.draft ? (
											<span class="border-primary/40 bg-primary/10 text-primary rounded-full border px-2 py-0.5 text-xs font-semibold tracking-wide uppercase">
												Draft
											</span>
										) : null}
									</div>
									<h2 class="text-2xl font-semibold tracking-tight">
										<a
											href={withBase(`blog/${postSlug}/`)}
											class="hover:text-primary transition-colors"
										>
											{post.data.title}
										</a>
									</h2>
									<p class="text-muted-foreground max-w-3xl text-base leading-7">
										{post.data.description}
									</p>
								</div>
							</div>
							{post.data.tags.length ? (
								<ul class="mt-5 flex flex-wrap gap-2">
									{post.data.tags.map((tag) => (
										<li class="border-border text-muted-foreground border px-2.5 py-1 text-xs">
											#{tag}
										</li>
									))}
								</ul>
							) : null}
						</article>
					);
				})
			}
		</div>
	</main>
</Layout>
