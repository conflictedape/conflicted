---
import { Mail, MoveDownLeft } from 'lucide-react';

import { GithubIcon } from '@/components/icons/GithubIcon';
import { XIcon } from '@/components/icons/XIcon';
import { PROFILE } from '@/data/profile';
import { withBase } from '@/lib/constants';

const iconFor = { github: GithubIcon, x: XIcon, mail: Mail } as const;
---

<section class="grid gap-10 sm:grid-cols-[1fr_auto] sm:items-start">
	<div class="space-y-6">
		<h1
			class="text-3xl leading-snug font-extrabold tracking-tight sm:text-4xl sm:leading-snug md:text-4xl md:leading-snug lg:text-5xl lg:leading-tight xl:text-6xl xl:leading-tight"
		>
			Hi, I'm <span class="text-primary">{PROFILE.name}</span>.
		</h1>

		<div
			class="text-muted-foreground max-w-2xl space-y-3 text-base leading-6 sm:text-lg sm:leading-7 md:text-lg md:leading-7 lg:text-xl lg:leading-8"
		>
			{PROFILE.bio.map((paragraph) => <p>{paragraph}</p>)}
		</div>

		<!-- <p class="text-muted-foreground max-w-xl text-base leading-7">
			{PROFILE.availabilityPrefix}{' '}
			<span class="text-primary font-semibold">{PROFILE.availabilityHighlight}</span>.
		</p>

		<p class="text-muted-foreground text-base leading-7">
			Currently based in <span class="text-foreground font-semibold">{PROFILE.location}</span>.
		</p> -->

		<div class="flex items-center gap-4">
			{
				PROFILE.socialLinks.map((link) => {
					const Icon = iconFor[link.icon];
					return (
						<a
							href={link.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={link.label}
							class="text-primary hover:text-foreground transition-colors"
						>
							<Icon className="h-5 w-5" />
						</a>
					);
				})
			}
		</div>

		<ul class="flex flex-wrap gap-2">
			{
				PROFILE.skills.map((skill) => (
					<li class="border-border text-muted-foreground border px-2.5 py-1 text-xs">{skill}</li>
				))
			}
		</ul>
	</div>

	<!-- Adjust the translate-x/translate-y values below to reposition the photo -->
	<div class="relative mx-auto sm:mx-0">
		<p class="text-muted-foreground absolute -top-6 right-0 font-mono text-sm italic">
			{PROFILE.photo.caption}
		</p>
		<!-- <MoveDownLeft className="text-muted-foreground absolute top-0 right-0 h-4 w-4" /> -->
		{
			PROFILE.photo.src ? (
				<img
					src={withBase(PROFILE.photo.src)}
					alt={PROFILE.photo.alt}
					class="border-border aspect-square w-56 max-w-full rounded-xl border object-cover sm:w-60 md:w-64 lg:w-80 xl:w-97.5"
					width="390"
					height="390"
				/>
			) : (
				<div
					class="border-border bg-muted text-muted-foreground flex aspect-square w-56 max-w-full items-center justify-center rounded-xl border font-mono text-4xl sm:w-60 md:w-64 lg:w-80 xl:w-97.5"
					aria-label={PROFILE.photo.alt}
					role="img"
				>
					{PROFILE.photo.placeholderInitials}
				</div>
			)
		}
	</div>
</section>
